{
  "name": "spoonate",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/student",
    "apps/canteen",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:student": "npm run dev --workspace=@spoonate/student",
    "dev:canteen": "npm run dev --workspace=@spoonate/canteen",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@spoonate/portal",
    "test:dev": "node --test scripts/*.test.mjs",
    "lint": "eslint apps packages scripts",
    "setup": "npm ci && npm --prefix backend ci",
    "dev:api": "npm --prefix backend run dev",
    "dev:worker": "npm --prefix backend run worker:dev",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:origins": "node scripts/set-release-origins.mjs"
  },
  "type": "module",
  "overrides": {
    "minimatch": "11.0.8"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1"
  }
}

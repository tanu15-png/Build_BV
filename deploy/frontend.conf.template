# Railway's HTTPS edge supplies a canonical X-Real-IP. The API remains private.
map $http_x_real_ip $spoonate_client_ip {
    default $http_x_real_ip;
    "" $remote_addr;
}
server {
    listen 0.0.0.0:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 5m;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location = /health/live {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /api/ {
        # Use a variable to resolve Railway's private hostname at request time.
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $spoonate_client_ip;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /banners/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

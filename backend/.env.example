NODE_ENV=development
APP_ENV=development
PORT=4000
# Server only. Use a least-privilege role; never expose through VITE_*.
DATABASE_URL=postgresql://spoonate:local-only-password@localhost:5433/spoonate
# Separate owner credentials for Prisma migrations; direct/session connection, not transaction pool.
MIGRATION_DATABASE_URL=postgresql://spoonate:local-only-password@localhost:5433/spoonate
# Required for Supabase Auth. SMTP credentials belong in the Supabase dashboard.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# EMAIL_PROVIDER=supabase
FRONTEND_ORIGIN=http://localhost:5173
ORDER_MODE=TEST
SEED_DEVELOPMENT_DATA=false
EMAIL_VERIFICATION_BYPASS=false
# Replace both with distinct random values (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
SESSION_SECRET=replace-with-random-session-secret-32-chars
OTP_SECRET=replace-with-random-otp-secret-at-least-32-chars
SESSION_TTL_SECONDS=43200
OTP_TTL_SECONDS=600
DB_TIMEOUT_MS=2000
DB_POOL_MAX=10
# Supabase session pooler (copy the exact host from Connect):
# DATABASE_URL=postgresql://spoonate_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&uselibpqcompat=true
# MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Development example above encrypts without certificate verification. Deployed environments
# require sslmode=verify-full; use sslrootcert=/absolute/path/to/ca.crt when needed.
JSON_LIMIT_BYTES=102400
LOG_LEVEL=info
EMAIL_PROVIDER=console
# Required for staging/production:
# EMAIL_API_URL=https://provider.example/send
# EMAIL_API_KEY=replace-me
# EMAIL_FROM=orders@example.edu
# TEST_DATABASE_URL=postgresql://spoonate:local-only-password@localhost:5434/spoonate_test

# Phase 9: run a separate worker with the same application database/configuration.
OUTBOX_POLL_MS=1000
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BATCH_SIZE=25
# NOTIFICATION_TEST_DATABASE_URL=postgresql://spoonate:local-only-password@localhost:5434/spoonate_notifications_test

# PICKUP_TEST_DATABASE_URL=postgresql://spoonate:local-only-password@localhost:5434/spoonate_pickup_test

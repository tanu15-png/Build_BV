{
  "name": "backend",
  "version": "1.0.0",
  "description": "SpoonAte API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:auth": "tsx --test tests/integration/auth.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/cli/seed.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx src/cli/check.ts",
    "auth:check": "node --env-file-if-exists=.env --import tsx src/cli/auth-check.ts",
    "provision:initial": "node --env-file-if-exists=.env --import tsx src/cli/initial.ts",
    "provision:admin": "node --env-file-if-exists=.env --import tsx src/cli/admin.ts",
    "provision:code": "node --env-file-if-exists=.env --import tsx src/cli/code.ts",
    "test:catalog": "tsx --test tests/integration/catalog.test.ts",
    "test:orders": "tsx --test tests/integration/orders.test.ts",
    "orders:check": "node --env-file-if-exists=.env --import tsx src/cli/orders-check.ts",
    "worker:dev": "node --env-file-if-exists=.env --import tsx src/outbox-worker.ts",
    "worker:start": "node --env-file-if-exists=.env dist/outbox-worker.js",
    "worker:retry": "node --env-file-if-exists=.env --import tsx src/cli/outbox-retry.ts",
    "test:notifications": "tsx --test tests/integration/notifications.test.ts",
    "test:pickup": "tsx --test tests/integration/pickup.test.ts",
    "test:admin": "tsx --test tests/integration/admin.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}

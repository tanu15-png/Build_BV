generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  STUDENT
  CANTEEN
  ADMIN
}
enum AccountStatus {
  ACTIVE
  DISABLED
}
enum MembershipStatus {
  ACTIVE
  REVOKED
}
enum OrderStatus {
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  COLLECTED
}
enum ChallengePurpose {
  SIGNUP
  PASSWORD_RESET
  CANTEEN_LOGIN
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String? @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  roles UserRole[]
  memberships CanteenMembership[]
  sessions Session[]
  cart Cart?
  orders Order[]
  notifications Notification[]
  idempotencyKeys IdempotencyKey[]
  events OrderEvent[]
  audits AuditLog[]
  @@map("users")
}
model UserRole {
  userId String @map("user_id") @db.Uuid
  role Role
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([userId, role])
  @@map("user_roles")
}
model Canteen {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  location String?
  hours String?
  acceptingOrders Boolean @default(true) @map("accepting_orders")
  operational Boolean @default(true)
  version Int @default(1)
  accessCodes CanteenAccessCode[]
  memberships CanteenMembership[]
  challenges AuthChallenge[]
  sessions Session[]
  menuItems MenuItem[]
  carts Cart[]
  cartItems CartItem[]
  orders Order[]
  @@map("canteens")
}
model CanteenAccessCode {
  id String @id @default(uuid()) @db.Uuid
  canteenId String @map("canteen_id") @db.Uuid
  codeHash String @map("code_hash")
  version Int
  active Boolean @default(true)
  rotatedAt DateTime @default(now()) @map("rotated_at") @db.Timestamptz
  rotatedBy String? @map("rotated_by") @db.Uuid
  canteen Canteen @relation(fields: [canteenId], references: [id], onDelete: Restrict)
  @@unique([canteenId, version])
  @@map("canteen_access_codes")
}
model CanteenMembership {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  canteenId String @map("canteen_id") @db.Uuid
  status MembershipStatus @default(ACTIVE)
  codeVersion Int @map("code_version")
  version Int @default(1)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy String? @map("revoked_by") @db.Uuid
  restoredAt DateTime? @map("restored_at") @db.Timestamptz
  restoredBy String? @map("restored_by") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  canteen Canteen @relation(fields: [canteenId], references: [id], onDelete: Restrict)
  sessions Session[]
  @@unique([userId, canteenId])
  @@unique([id, userId, canteenId])
  @@map("canteen_memberships")
}
model AuthChallenge {
  id String @id @default(uuid()) @db.Uuid
  purpose ChallengePurpose
  email String
  canteenId String? @map("canteen_id") @db.Uuid
  otpHash String @map("otp_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  attempts Int @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  version Int @default(1)
  accessCodeVersion Int? @map("access_code_version")
  signupName String? @map("signup_name")
  pendingPasswordHash String? @map("pending_password_hash")
  resetContext Json? @map("reset_context")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  canteen Canteen? @relation(fields: [canteenId], references: [id], onDelete: Restrict)
  @@index([email, purpose, expiresAt])
  @@map("auth_challenges")
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  userId String @map("user_id") @db.Uuid
  role Role
  canteenId String? @map("canteen_id") @db.Uuid
  membershipId String? @map("membership_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  canteen Canteen? @relation(fields: [canteenId], references: [id], onDelete: Restrict)
  membership CanteenMembership? @relation(fields: [membershipId, userId, canteenId], references: [id, userId, canteenId], onDelete: Restrict)
  @@index([membershipId, revokedAt, expiresAt])
  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}
model MenuItem {
  id String @id @default(uuid()) @db.Uuid
  canteenId String @map("canteen_id") @db.Uuid
  name String
  description String?
  category String
  pricePaise Int @map("price_paise")
  available Boolean @default(true)
  archived Boolean @default(false)
  version Int @default(1)
  imageRef String? @map("image_ref")
  canteen Canteen @relation(fields: [canteenId], references: [id], onDelete: Restrict)
  cartItems CartItem[]
  orderItems OrderItem[]
  @@unique([id, canteenId])
  @@index([canteenId, archived, available])
  @@map("menu_items")
}
model Cart {
  id String @id @default(uuid()) @db.Uuid
  studentId String @unique @map("student_id") @db.Uuid
  canteenId String? @map("canteen_id") @db.Uuid
  version Int @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  canteen Canteen? @relation(fields: [canteenId], references: [id], onDelete: Restrict)
  items CartItem[]
  @@unique([id, canteenId])
  @@map("carts")
}
model CartItem {
  id String @id @default(uuid()) @db.Uuid
  cartId String @map("cart_id") @db.Uuid
  menuItemId String @map("menu_item_id") @db.Uuid
  canteenId String @map("canteen_id") @db.Uuid
  quantity Int
  cart Cart @relation(fields: [cartId, canteenId], references: [id, canteenId], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId, canteenId], references: [id, canteenId], onDelete: Restrict)
  canteen Canteen @relation(fields: [canteenId], references: [id], onDelete: Restrict)
  @@unique([cartId, menuItemId])
  @@map("cart_items")
}
model Order {
  id String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  canteenId String @map("canteen_id") @db.Uuid
  status OrderStatus @default(RECEIVED)
  executionMode String @default("TEST") @map("execution_mode")
  paymentStatus String @default("NOT_REQUIRED_TEST") @map("payment_status")
  totalPaise Int @map("total_paise")
  pickupAt DateTime @map("pickup_at") @db.Timestamptz
  codeDay DateTime @map("code_day") @db.Date
  orderCode String? @map("order_code") @db.VarChar(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  collectedAt DateTime? @map("collected_at") @db.Timestamptz
  pickupVerifiedBy String? @map("pickup_verified_by") @db.Uuid
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  canteen Canteen @relation(fields: [canteenId], references: [id], onDelete: Restrict)
  items OrderItem[]
  events OrderEvent[]
  allocation OrderCodeAllocation?
  notifications Notification[]
  idempotencyKeys IdempotencyKey[]
  @@unique([id, codeDay, orderCode])
  @@unique([codeDay, orderCode])
  @@index([studentId, createdAt])
  @@index([canteenId, status, pickupAt])
  @@map("orders")
}
model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  menuItemId String? @map("menu_item_id") @db.Uuid
  name String
  quantity Int
  unitPricePaise Int @map("unit_price_paise")
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  @@index([orderId])
  @@map("order_items")
}
model OrderEvent {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  previousStatus OrderStatus? @map("previous_status")
  newStatus OrderStatus @map("new_status")
  actorId String @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  notifications Notification[]
  outboxEvents OutboxEvent[]
  @@index([orderId, createdAt])
  @@map("order_events")
}
model OrderCodeAllocation {
  orderId String @id @map("order_id") @db.Uuid
  codeDay DateTime @map("code_day") @db.Date
  code String @db.VarChar(3)
  allocatedAt DateTime @default(now()) @map("allocated_at") @db.Timestamptz
  order Order @relation(fields: [orderId, codeDay, code], references: [id, codeDay, orderCode], onDelete: Restrict)
  @@unique([orderId, codeDay, code])
  @@unique([codeDay, code])
  @@map("order_code_allocations")
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid
  sourceEventId String @map("source_event_id") @db.Uuid
  orderId String @map("order_id") @db.Uuid
  type String
  message String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  readAt DateTime? @map("read_at") @db.Timestamptz
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  sourceEvent OrderEvent @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@unique([recipientId, sourceEventId, type])
  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  payload Json
  state String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz
  leaseOwner String? @map("lease_owner")
  lastError String? @map("last_error")
  event OrderEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@index([state, availableAt, leaseUntil])
  @@map("outbox_events")
}
model IdempotencyKey {
  id String @id @default(uuid()) @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String
  key String
  requestHash String @map("request_hash")
  state String @default("PENDING")
  response Json?
  responseStatus Int? @map("response_status")
  orderId String? @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@unique([actorId, action, key])
  @@map("idempotency_keys")
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String
  target String
  metadata Json?
  requestId String @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([target, createdAt])
  @@map("audit_logs")
}
model RateLimit {
  key String @id
  windowEndsAt DateTime @map("window_ends_at") @db.Timestamptz
  count Int @default(0)
  @@index([windowEndsAt])
  @@map("rate_limits")
}
